<CustomFaction name="DLC Faction" id="Bibliotheque" playerVal="0">
  <!-- Localization Guide:
  ONLY translate the content of AddIRCMessage Tags.
  Do NOT change text surrounded by # marks (like #PLAYERNAME#)
  Do NOT change text surrounded by ! marks (like !ANNOUNCEMENT!)
  Do NOT translate the agent names. Names are Coel, D3f4ult and Kaguya. Also included in this is keyword "Channel".
  Make sure you leave @Mentions intact!
  
  For example in the line below:
  Welcome to the team @#PLAYERNAME#!
  
  "@#PLAYERNAME#" should be left intact, the rest should be translated!
  
  Complex cases:
  Attachments or links look like this:
  !ATTACHMENT:note#%#SSL Trojan Usage#%#Some text here
  For these, Do not translate !ATTACHMENT:note#%#
  but you SHOULD translate the bits in between the #%# separator marks (the title and content of the note, in this case)
  
  Any questions about this, please let me know! I'm reachable via matt@hacknet-os.com
  -->
  <Action ValueRequired="1">
    
    <RunFunction FunctionName="changeSongDLC" FunctionValue="9" />
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/1/DSet1Mission1.xml" TargetComp="dhs" AssignmentTag="D3f4ult" StartsComplete="false"/>
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/1/DSet1Mission2.xml" TargetComp="dhs" />
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/1/DSet1Mission3.xml" TargetComp="dhs" AssignmentTag="Coel" StartsComplete="false"/>

    <AddConditionalActions Filepath="DLC/ActionScripts/StartupActions.xml" />

    <AddIRCMessage Author="Channel" TargetComp="dhs" Delay="0.1">!ANNOUNCEMENT!</AddIRCMessage>
    <AddIRCMessage Author="Channel" TargetComp="dhs" Delay="0.3">ユーザー"#PLAYERNAME#"がホワイトリストに追加されました。</AddIRCMessage>
    
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="4.0">@channel #PLAYERNAME#を歓迎します。</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="10.2">@#PLAYERNAME# - 試験突破おめでとうございます。
他のメンバーは既に仕事に取りかかっています――心配しなくても、すぐ追いつけますよ。</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="15.0">あなたはもうチームの一員です。残っている案件はあなたが請け負ってくれて構いません。</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="25.1">ミッションはこのシステムに掲示されます。管理、監視等は主に私が担当しています。目標達成のために必要なものをメンバー全員に行き渡るよう取り仕切るのも私の役目です。それぞれの仕事に必要なツールや情報を整理し、共有するというわけです。</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="31.0">@Coel, @D3f4ult - 手が空き次第、自己紹介を。</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="36.0">それから、@#PLAYERNAME#はサーバーの中を見て、残っている案件に目を通してください。</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="42.0">私たちのチームへようこそ。</AddIRCMessage>

    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="65.0">やあ @#PLAYERNAME# 仲間が増えて嬉しいよ。</AddIRCMessage>
    <AddIRCMessage Author="Coel" TargetComp="dhs" Delay="72.0">ようこそ @#PLAYERNAME#！</AddIRCMessage>

    <!-- Add dynamic response set for when the player reconnects to the server after doing the mission -->
    <AddConditionalActions Filepath="DLC/ActionScripts/Set1ResponseActions.xml" />
  </Action>

  <Action ValueRequired="2">
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/2/DSet2Mission1.xml" TargetComp="dhs" AssignmentTag="D3f4ult" StartsComplete="true"/>
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/2/DSet2Mission2.xml" TargetComp="dhs" AssignmentTag="Coel" StartsComplete="false"/>
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/2/DSet2Mission3.xml" TargetComp="dhs"/>
    
    
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="9.0">よしきた、このSSL破りはこっちも欲しかったからね。復号して、使えるツールに仕立てておくよ。</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="17.0">まるで自分用に作ったみたいに使いやすいな。前に見たことがある、トロイの木馬タイプだ…</AddIRCMessage>
    <AddAsset FileName="SSLTrojan.exe" FileContents="#SSL_EXE#" TargetComp="dhsDrop" TargetFolderpath="bin" />
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="22.0">ちょいテスト不足だけど、急ぐならこのビルドでも実用レベルだから、ドロップサーバーの/binにアップロードしとくよ。</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="27.0">!ATTACHMENT:link#%#Bibliotheque DropServer#%#69.58.186.118</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="32.0">!ATTACHMENT:account#%#Bibliotheque DropServer#%#69.58.186.118#%#admin#%#ka2gs69</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="36.0">で、ざっくり説明すると、プログラムは予め開いているポートをトンネルみたいに通ってSSLポートをハイジャックするようになってる。</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="40.0">つまり、SSLポート番号だけじゃなく、通り道になるポートを指定するフラグと、「その」ポート番号も入力しないといけない。</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="43.0">SSHは[-s]HTTPは[-w]、FTPは[-f]で指定できる。</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="45.0">こんな感じ。</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="50.0">SSLTrojan [SSLポート番号] [フラグ] [トンネルポート番号]</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="52.0">まとめ:</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="62.0">!ATTACHMENT:note#%#SSL Trojan Usage#%#SSLTrojan [1] [2] [3]
1 = SSLポート番号
2 =
"-s" for SSHトンネル
"-f" for FTPトンネル
"-w" for HTTPトンネル
3 = トンネルとして使う他のサービスのポート番号
例: "SSLTrojan 443 -w 80"</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="66.0">もう一度言うけど、SSLTrojanは別のポートを「通って」動く。最初にそのポートを開いておかないと使えないから。</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="70.0">@channel - 新しいおもちゃだ！遊び方は上のとおり。</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="90.0">素晴らしい要約をありがとうございます、	@D3f4ult</AddIRCMessage>
  </Action>

