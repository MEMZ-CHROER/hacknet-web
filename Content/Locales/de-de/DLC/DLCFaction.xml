<CustomFaction name="DLC Faction" id="Bibliotheque" playerVal="0">
  <!-- Localization Guide:
  ONLY translate the content of AddIRCMessage Tags.
  Do NOT change text surrounded by # marks (like #PLAYERNAME#)
  Do NOT change text surrounded by ! marks (like !ANNOUNCEMENT!)
  Do NOT translate the agent names. Names are Coel, D3f4ult and Kaguya. Also included in this is keyword "Channel".
  Make sure you leave @Mentions intact!
  
  For example in the line below:
  Welcome to the team @#PLAYERNAME#!
  
  "@#PLAYERNAME#" should be left intact, the rest should be translated!
  
  Complex cases:
  Attachments or links look like this:
  !ATTACHMENT:note#%#SSL Trojan Usage#%#Some text here
  For these, Do not translate !ATTACHMENT:note#%#
  but you SHOULD translate the bits in between the #%# separator marks (the title and content of the note, in this case)
  
  Any questions about this, please let me know! I'm reachable via matt@hacknet-os.com
  -->
  <Action ValueRequired="1">
    
    <RunFunction FunctionName="changeSongDLC" FunctionValue="9" />
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/1/DSet1Mission1.xml" TargetComp="dhs" AssignmentTag="D3f4ult" StartsComplete="false"/>
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/1/DSet1Mission2.xml" TargetComp="dhs" />
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/1/DSet1Mission3.xml" TargetComp="dhs" AssignmentTag="Coel" StartsComplete="false"/>

    <AddConditionalActions Filepath="DLC/ActionScripts/StartupActions.xml" />

    <AddIRCMessage Author="Channel" TargetComp="dhs" Delay="0.1">!ANNOUNCEMENT!</AddIRCMessage>
    <AddIRCMessage Author="Channel" TargetComp="dhs" Delay="0.3">User "#PLAYERNAME#" zur Whitelist hinzugefügt.</AddIRCMessage>
    
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="4.0">@channel, ich möchte #PLAYERNAME# in der Gemeinde willkommen heißen.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="10.2">@#PLAYERNAME# – Glückwunsch zum Bestehen der Tests.
Die anderen sind gerade mit Aufgaben beschäftigt – du dürftest also etwas Zeit haben, um aufzuholen, wenn du diese Runde schon einsteigen willst.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="15.0">Du bist jetzt im Team und damit gehört der letzte Auftrag dir.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="25.1">Für Aufträge gilt hier das Prinzip "Wer zuerst kommt, malt zuerst" – ich kümmere mich hauptsächlich um Administration, Infos und so – dass jeder genug zu tun hat, um auf unsere Ziele hinzuarbeiten, und dass alle die Tools und Infos haben, die sie für ihre Arbeit brauchen.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="31.0">@Coel, @D3f4ult – stellt euch mal vor, wenn ihr kurz Zeit habt.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="36.0">@#PLAYERNAME#, in der Zwischenzeit kannst du einen Blick auf den Server und diesen offenen Auftrag werfen.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="42.0">Willkommen im Team.</AddIRCMessage>

    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="65.0">Hey @#PLAYERNAME#, schön, dich dabei zu haben.</AddIRCMessage>
    <AddIRCMessage Author="Coel" TargetComp="dhs" Delay="72.0">Willkommen im Team, @#PLAYERNAME#!</AddIRCMessage>

    <!-- Add dynamic response set for when the player reconnects to the server after doing the mission -->
    <AddConditionalActions Filepath="DLC/ActionScripts/Set1ResponseActions.xml" />
  </Action>

  <Action ValueRequired="2">
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/2/DSet2Mission1.xml" TargetComp="dhs" AssignmentTag="D3f4ult" StartsComplete="true"/>
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/2/DSet2Mission2.xml" TargetComp="dhs" AssignmentTag="Coel" StartsComplete="false"/>
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/2/DSet2Mission3.xml" TargetComp="dhs"/>
    
    
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="9.0">In Ordnung, ich schau mir mal dieses SSL-Zeug an, entschlüssle es und pack das Ganze in ein praktischeres Format.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="17.0">Sieht tatsächlich aus, als ob das meiste davon schon erledigt sei – ich habe diesen Typ Trojaner schon mal gesehen ...</AddIRCMessage>
    <AddAsset FileName="SSLTrojan.exe" FileContents="#SSL_EXE#" TargetComp="dhsDrop" TargetFolderpath="bin" />
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="22.0">Der Build ist noch nicht ganz ausgereift, aber sollte gehen, wenn ihr direkt loslegen wollt. Ich habs auf den Drop-Server (/bin) hochgeladen.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="27.0">!ATTACHMENT:link#%#Bibliotheque DropServer#%#69.58.186.118</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="32.0">!ATTACHMENT:account#%#Bibliotheque DropServer#%#69.58.186.118#%#admin#%#ka2gs69</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="36.0">Okay, dieses Programm tunnelt sich im Grunde durch einen bereits geöffneten Port, um den SSL-Port zu übernehmen.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="40.0">Dafür wird nicht nur die Nummer des SSL-Ports gebraucht, sondern auch eine Flag, die anzeigt, durch welchen Service die Software tunneln soll, und *DESSEN* Portnummer.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="43.0">Die aktuellen Flags sind -s, -w und -f, für je ssh, http und ftp.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="45.0">Sieht dann etwa so aus</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="50.0">SSLTrojan [SSL NUMBER] [FLAG] [TUNNEL PORT NUMBER]</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="52.0">Zusammenfassung:</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="62.0">!ATTACHMENT:note#%#SSL Trojan Anleitung#%#SSLTrojan [1] [2] [3]
1 = Portnummer des SSL-Ports
2 = 
"-s" für SSH-Tunnel
"-f" für FTP-Tunnel
"-w" für HTTP-Tunnel
3 = Portnummer des Dienstes, durch den du tunnelst.
z. B.: SSLTrojan 443 -w 80</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="66.0">Denk daran – SSLTrojan läuft *DURCH* einen anderen Port. Der Port muss also zuerst geöffnet werden.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="70.0">@channel – Neues Spielzeug! Siehe oben.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="90.0">Gute Zusammenfassung, @D3f4ult – danke.</AddIRCMessage>
  </Action>

