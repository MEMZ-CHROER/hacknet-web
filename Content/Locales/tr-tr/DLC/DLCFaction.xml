    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="9.0">Pekala, şu SSL meselesiyle ilgileniyorum. Çözümleyip kullanışlı hale getireceğim.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="17.0">Buna yapacak pek bir şey yok gibi aslında. Bu trojan türünü daha önce de görmüştüm..</AddIRCMessage>
    <AddAsset FileName="SSLTrojan.exe" FileContents="#SSL_EXE#" TargetComp="dhsDrop" TargetFolderpath="bin" />
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="22.0">Pek test edilmemiş ancak acelem var diyorsanız kullanabilirsiniz. Sürümü Drop Server'a (/bin) yükledim.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="27.0">!ATTACHMENT:link#%#Kütüphane DropServer#%#69.58.186.118</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="32.0">!ATTACHMENT:account#%#Kütüphane DropServer#%#69.58.186.118#%#admin#%#ka2gs69</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="36.0">Kısaca bu program SSL'i ele geçirmek için açık portlardan birine tünel açıyor.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="40.0">Yani SSL port numarasının yanında tünel açmak istediğiniz *PORTUN* değerine ve numarasına da ihtiyacınız olacak.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="43.0">SSH, HTTP ve FTP için mevcut olan değerler -s, -w ve -f.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="45.0">Kullanımı iste şu şekilde</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="50.0">SSLTrojan [SSL NUMARASI] [DEĞER] [TÜNEL PORTUNUN NUMRARASI]</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="52.0">Özet Kılavuzu:</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="62.0">!ATTACHMENT:note#%#SSL Trojan Kullanımı#%#SSLTrojan [1] [2] [3]
1 = SSL Portu Numarası
2 =
"-s" - SSH Tüneli İçin
"-f" - FTP Tüneli İçin
"-w" - HTTP Tüneli İçin
3 = Tüneli açtığınız türün port numarası
ÖRNEK: "SSLTrojan 443 -w 80"</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="66.0">Unutmayın: SSLTrojan diğer porta göre *İŞLER*. Yani öncelikle diğer portun açık olması gerekir.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="70.0">@channel - Yeni oyuncağınız geldi. Üstte yazanları okuyun.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="90.0">Harikasın @D3f4ult - Teşekkürler.</AddIRCMessage>
  </Action>

