<CustomFaction name="DLC Faction" id="Bibliotheque" playerVal="0">
  <!-- Localization Guide:
  ONLY translate the content of AddIRCMessage Tags.
  Do NOT change text surrounded by # marks (like #PLAYERNAME#)
  Do NOT change text surrounded by ! marks (like !ANNOUNCEMENT!)
  Do NOT translate the agent names. Names are Coel, D3f4ult and Kaguya. Also included in this is keyword "Channel".
  Make sure you leave @Mentions intact!
  
  For example in the line below:
  Welcome to the team @#PLAYERNAME#!
  
  "@#PLAYERNAME#" should be left intact, the rest should be translated!
  
  Complex cases:
  Attachments or links look like this:
  !ATTACHMENT:note#%#SSL Trojan Usage#%#Some text here
  For these, Do not translate !ATTACHMENT:note#%#
  but you SHOULD translate the bits in between the #%# separator marks (the title and content of the note, in this case)
  
  Any questions about this, please let me know! I'm reachable via matt@hacknet-os.com
  -->
  <Action ValueRequired="1">
    
    <RunFunction FunctionName="changeSongDLC" FunctionValue="9" />
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/1/DSet1Mission1.xml" TargetComp="dhs" AssignmentTag="D3f4ult" StartsComplete="false"/>
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/1/DSet1Mission2.xml" TargetComp="dhs" />
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/1/DSet1Mission3.xml" TargetComp="dhs" AssignmentTag="Coel" StartsComplete="false"/>

    <AddConditionalActions Filepath="DLC/ActionScripts/StartupActions.xml" />

    <AddIRCMessage Author="Channel" TargetComp="dhs" Delay="0.1">!ANNOUNCEMENT!</AddIRCMessage>
    <AddIRCMessage Author="Channel" TargetComp="dhs" Delay="0.3">Nombre de usuario "#PLAYERNAME#" añadido a la lista de permisos.</AddIRCMessage>
    
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="4.0">@channel, me gustaría dar la bienvenida a #PLAYERNAME#.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="10.2">@#PLAYERNAME#, enhorabuena por superar las pruebas.
Los demás no tienen ahora ningún encargo. Ya tendrás tiempo de superarlos en esta ronda.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="15.0">Ahora estás en el equipo, así que el contrato final te pertenece.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="25.1">Los contratos aparecen por orden de llegada al sistema —yo me encargo principalmente del admin, el recon y todo eso— me aseguro de que todo el mundo tenga algo que hacer para ayudarnos a cumplir nuestros objetivos. Todo el mundo tiene las herramientas y la información necesarias para el trabajo.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="31.0">@Coel, @D3f4ult, presentaos cuando tengáis un segundo.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="36.0">Mientras tanto, @#PLAYERNAME#, comprueba el servidor y echa un vistazo al último trabajo.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="42.0">Te doy la bienvenida al equipo.</AddIRCMessage>

    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="65.0">¡Eh! @#PLAYERNAME#, nos alegramos de tenerte con nosotros.</AddIRCMessage>
    <AddIRCMessage Author="Coel" TargetComp="dhs" Delay="72.0">¡Te doy la bienvenida al equipo, @#PLAYERNAME#!</AddIRCMessage>

    <!-- Add dynamic response set for when the player reconnects to the server after doing the mission -->
    <AddConditionalActions Filepath="DLC/ActionScripts/Set1ResponseActions.xml" />
  </Action>

  <Action ValueRequired="2">
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/2/DSet2Mission1.xml" TargetComp="dhs" AssignmentTag="D3f4ult" StartsComplete="true"/>
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/2/DSet2Mission2.xml" TargetComp="dhs" AssignmentTag="Coel" StartsComplete="false"/>
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/2/DSet2Mission3.xml" TargetComp="dhs"/>
    
    
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="9.0">Bien, estoy echando un vistazo a  todas estas cosas del SSL, desencriptándolo y convirtiéndolo en algo práctico.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="17.0">Creo que ya está todo prácticamente hecho, ya he visto antes este tipo de troyano...</AddIRCMessage>
    <AddAsset FileName="SSLTrojan.exe" FileContents="#SSL_EXE#" TargetComp="dhsDrop" TargetFolderpath="bin" />
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="22.0">Aún no la he puesto a prueba, pero esta compilación es útil si quieres ir más rápido. Ya la he subido al servidor de almacenamiento (/bin).</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="27.0">!ATTACHMENT:link#%#Servidor de la biblioteca#%#69.58.186.118</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="32.0">!ATTACHMENT:account#%#Servidor de la biblioteca#%#69.58.186.118#%#admin#%#ka2gs69</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="36.0">Vale, lo que hace este programa, básicamente, es crear un túnel a través de un puerto ya abierto para apropiarse del SSL.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="40.0">Así que tendrás que proveer el número de puerto SSL pero también una señal que indique qué puerto debe atravesar tu túnel y el número de *ESE* puerto.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="43.0">Las marcas actuales son -s, -w y -f, para ssh, http y ftp respectivamente.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="45.0">Utilízalas así</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="50.0">SSLTroyano [SSL NUMBER] [FLAG] [TUNNEL PORT NUMBER]</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="52.0">Guía de resumen:</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="62.0">!ATTACHMENT:note#%#Uso de Troyano SSL #%#SSLTrojan [1] [2] [3]
1 = Número de puerto de SSL Puerto
2 = 
"-s" para Túnel SSH
"-f" para Túnel FTP
"-w" para Túnel HTTP
3 = Número de puerto del otro servicio para el que estás creando túneles.
Es decir: Troyano SSL 443 -w 80</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="66.0">Recuerda: el TroyanoSSL va *A TRAVÉS DE* otro puerto, así que ese puerto debe abrirse primero.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="70.0">@channel - ¡Juguetes nuevos! Lee arriba.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="90.0">Gran resumen, @D3f4ult. Gracias.</AddIRCMessage>
  </Action>

