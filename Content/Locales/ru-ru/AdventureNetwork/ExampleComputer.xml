<?xml version = "1.0" encoding = "UTF-8" ?>
<Computer id="advExamplePC" 
          name="Adventure Example PC" 
          ip="167.194.132.7"
          security="2"
          allowsDefaultBootModule="false"
          icon="chip" 
          type="1" > <!-- 1=  corporate, 2 = Home, 3 = server 4 = empty -->
  <!--иконка:  исключая это, используются значения по умолчанию заданные уровнем защиты, alt опции "chip" и "laptop" -->
  
  <!-- 
  Степень защиты от 0 до 5 в зависимости от уровня сложности взлома
  От 1-4 - нужно открыть столько портов, в 4 и выше будет автоматически
  добавляться еще один уровень защиты с возможностью постепенного увеличения, ты можешь переписать спецификацию ниже
  
  AllowsDefaultBootModule -по умолчанию условие истинно и означает, что когда ты подключишься к узлу
  он автоматически запустит свою программу (последний демон обнаруженный в этом файле) и
  выведет ее на модуль дисплея.
  Так как в этом примере компьютер выдает много данных, я установил здесь значение на ложное.
  -->

  <!--Учетные записи -->
  <adminPass pass="password" />
  <account username="Matt" password="testpass" type="1" />
  <!-- Добавь учетную запись на этот компьютер.
  Тип представляет ее привилегии :
  АДМИН = 0;
  ВСЕ = 1;
  ПОЧТА = 2;
  СПИСОК МИССИЙ = 3;
  -->
  <account username="mailGuy" password="mailPass" type="2" /> <!-- Создай учетные записи для почтового сервера следующим образом -->
  
  <!-- Сведения о системе безопасности -->
  <ports>80, 22</ports>
  <proxy time="2" /> <!-- Proxy cервер. Установи значение на - 1 чтобы он исчез -->
  <portsForCrack val="2" /> <!-- Количество портов, которые нужно открыть для запуска porthack -->
  <firewall level="6" solution="Scypio" additionalTime="1.0"/>
  <!-- Добавь межсетевой экран - установи уровень на -1 чтобы удалить его.
      Решение - решение, которое игрок должен найти, чтобы взломать его, 
      в идеале, уровень должен быть по длительности таким же как и решение, но может быть и дольше
      (Но не короче!) - дополнительное время - нестандартное дополнительное время оценки
      на каждый шаг, которое требуется для решения задачи Hacknet-->
  <trace time="300" /> <!-- Добавь таймер трассировки -установи уровень на 1 - чтобы удалить его -->
  <admin type="fast" resetPassword="false" isSuper="false"/> 
  <!-- Автоматическое добавление администратора - переустанавливает порты и данные, когда игрок -
  отключается. Доступные режимы - "базовый" и "быстрый". Базовый запускает переустановку через 
  15 секунд или около того.
  Super admins переустанавливает пароли моментально в быстром режиме
  -->
  
  <!-- Данные сети -->
  <dlink target="advExamplePC2" /> <!-- Соединяет один компьютер с другим (односторонняя связь) - при запуске сканирования, отображаются соединения  -->
  
  <positionNear target="advExamplePC2" position="1" total="3" />
  <!-- Располагает компьютер рядом с целевым на карте сети
       Позиция - его радиальное расположение вокруг целевого, общее 
       количество всех имеющихся радиально расположенных узлов - таким образом ты можешь создать
       классные сетевые-->
  
  
  
  <!--Файлы -->
  <file path="home" name="Test_File">Это тестовый файл в корневом каталоге </file>
  <file path="bin" name="Binary_File">#BINARY#</file>
  <file path="home/NewDirectory" name="Test_File">
Это более длинное имя файла, которое также создает новый каталог при добавлении значения маршрута сети

    #BINARY#
    Он также генерирует двоичный код (состоящий из 2000 символов)

    #PLAYER_IP#
    Становится IP-адресом компьютера игрока

    #PLAYERNAME#
    вышеуказанная двоичная строка конвертируется в имя игрока

    test test
  </file>
  <file path="bin" name="SSHCrack.exe">#SSH_CRACK#</file>
  <file path="bin" name="FTPBounce.exe">#FTP_CRACK#</file>
  <file path="bin" name="WebServerWorm.exe">#WEB_CRACK#</file>
  <file path="bin" name="SMTPOverflow.exe">#SMTP_CRACK#</file>
  <file path="bin" name="SQLBufferOverflow.exe">#SQL_CRACK#</file>
  <!-- порт 1433 -->

  <file path="sys" name="White-Theme.sys">#WHITE_THEME#</file>
  <file path="sys" name="Green-Theme.sys">#GREEN_THEME#</file>
  <file path="sys" name="Yellow-Theme.sys">#YELLOW_THEME#</file>
  <file path="sys" name="Teal-Theme.sys">#TEAL_THEME#</file>

  <encryptedFile path="home" name="encrypted_File.dec" extension=".txt" ip="192.168.1.1" header="This is the header" pass="decryptionPassword">
    Это создает кодированный файл, который может быть дешифрован, используя вышеупомянутый пароль
  </encryptedFile>

  <encryptedFile path="home" name="easy_encrypted_File.dec" ip="192.168.1.1" header="This is the header">
    Просто не вводи такой пароль, его можно дешифровать и без пароля
  </encryptedFile>
  
  <!-- Демоны -->
  <!-- Это программы, исполняемые на узлах, которые делают нужные вещи
  Наврядли тебе удаться воспользоваться большинством из них, так как ты не можешь изменить их код
  но все же некоторые из них могут сработать-->

  <mailServer name="Example Mail Server" color="50,237,212">
    <email recipient="mailGuy" sender="Sender Guy" subject="Adding an email!">
Вот как добавить сообщения на почтовый сервер - регистрируешься под чьей-то учетной записью
и они будут выглядеть так же, как будто игрок получает сообщения.
    </email>
    <email recipient="mailGuy" sender="Spam" subject="amazing features">
Ты можешь создать их сколько угодно
    </email>
    <email recipient="Matt" sender="Spam" subject="amazing features">
Также различных пользователей
    </email>
  </mailServer>

  <!-- Добавив этот раздел, ты создашь второй рабочий компьютер, подключенный к тому,
  который является устройством eos, готовый к действию, с теми же файлами на нем.
  Он автоматически сгенерирует несколько приложений и сохранит файлы и объекты
  в случае чего.-->
  <eosDevice name="Deliliah's ePhone 4S" id="eosIntroPhone" icon="ePhone2">
    <note>TestNote
More text</note>
    <note>Note filenames
Записанные имена файлов генерируется автоматически и занимают первую строку файла
(в этом случае "Записанные имена файлов") и замещают пробелы подчеркиванием.</запись>
    <mail username="test@jmail.com" pass="thisIstheaccountpass" />
    <mail username="test2@jmail.com" pass="YouCanHaveLotsOfThese" />
  </eosDevice>

  <!--
  <addOnlineWebServer name="Reddit" url="http://www.reddit.com" />
  -->
  <!-- Это действие добавляет точную копию реальных веб-сайтов. У тебя может быть только один интернет-сервер
  на компьютер, поэтому и у этого он будет.-->

  <uploadServerDaemon name="Upload Dropbox" folder="Drop" 
                      needsAuth="false" color="204,116,212"/>
  <!-- Это специальный вид сервера, который позволяет загружать на него файлы 
       без разрешения администратора -->
  <addWebServer name="Website Server"
                url="Content/Web/Presets/Nortron/NortronPublicPage.html" />
  <!-- Web-сервера добавляются следующим образом - ты можешь добавить свои собственные веб-страницы к уже заранее созданным сетевым
  папкам и они будут отображаться в игре тоже! у них будет соответствующий html и все атрибуты (хотя
  они пока еще не поддерживают ввода данных) -->
  
  
  <!-- Бонус -->
  <!--
  <ExternalCounterpart id="testEP" name="External Counterpart Demo" />
  -->
  <!-- К этому виртуальному компьютеру добавляется реальный внешний двойник
  Если ты находишься в сеансе hacknet с работающим сервером, введи свой id и ip Content/Network/NetworkIPList.txt
  затем добавь сюда его внешний двойник, он будет работать как реальный сервер, когда ты будешь вводить
  в него данные - самое очевидное, что можно сделать - открыть CD лотки и ввести данные.
  -->
  
</Computer>
