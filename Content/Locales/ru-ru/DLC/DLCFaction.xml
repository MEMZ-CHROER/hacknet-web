<CustomFaction name="DLC Faction" id="Bibliotheque" playerVal="0">
  <!-- Localization Guide:
  ONLY translate the content of AddIRCMessage Tags.
  Do NOT change text surrounded by # marks (like #PLAYERNAME#)
  Do NOT change text surrounded by ! marks (like !ANNOUNCEMENT!)
  Do NOT translate the agent names. Names are Coel, D3f4ult and Kaguya. Also included in this is keyword "Channel".
  Make sure you leave @Mentions intact!
  
  For example in the line below:
  Welcome to the team @#PLAYERNAME#!
  
  "@#PLAYERNAME#" should be left intact, the rest should be translated!
  
  Complex cases:
  Attachments or links look like this:
  !ATTACHMENT:note#%#SSL Trojan Usage#%#Some text here
  For these, Do not translate !ATTACHMENT:note#%#
  but you SHOULD translate the bits in between the #%# separator marks (the title and content of the note, in this case)
  
  Any questions about this, please let me know! I'm reachable via matt@hacknet-os.com
  -->
  <Action ValueRequired="1">
    
    <RunFunction FunctionName="changeSongDLC" FunctionValue="9" />
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/1/DSet1Mission1.xml" TargetComp="dhs" AssignmentTag="D3f4ult" StartsComplete="false"/>
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/1/DSet1Mission2.xml" TargetComp="dhs" />
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/1/DSet1Mission3.xml" TargetComp="dhs" AssignmentTag="Coel" StartsComplete="false"/>

    <AddConditionalActions Filepath="DLC/ActionScripts/StartupActions.xml" />

    <AddIRCMessage Author="Channel" TargetComp="dhs" Delay="0.1">!ANNOUNCEMENT!</AddIRCMessage>
    <AddIRCMessage Author="Channel" TargetComp="dhs" Delay="0.3">Пользователь "#PLAYERNAME#" добавлен в белый список.</AddIRCMessage>
    
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="4.0">@channel, #PLAYERNAME#, добро пожаловать к нам.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="10.2">@#PLAYERNAME# - поздравляю с успешным прохождением тестов.
Остальные сейчас на задании, так что у тебя есть пока время освоиться.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="15.0">Теперь ты часть команды, так что последний контракт достается тебе.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="25.1">Работа здесь распределяется в форме "кто первый взял - тому и принаджежит" - я в основном занимаюсь администрированием, разведкой и прочим - в общем, слежу за тем, чтобы все у нас были заняты и имели под рукой необходимые для работы инструменты.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="31.0">@Coel, @D3f4ult - представьтесь, когда у вас будет минутка.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="36.0">А тем временем, @#PLAYERNAME#, проверь пожалуйста проекты и глянь на последнее задание.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="42.0">Добро пожаловать в команду.</AddIRCMessage>

    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="65.0">@#PLAYERNAME# Привет, рад знакомству.</AddIRCMessage>
    <AddIRCMessage Author="Coel" TargetComp="dhs" Delay="72.0">@#PLAYERNAME# Добро пожаловать в команду!</AddIRCMessage>

    <!-- Add dynamic response set for when the player reconnects to the server after doing the mission -->
    <AddConditionalActions Filepath="DLC/ActionScripts/Set1ResponseActions.xml" />
  </Action>

  <Action ValueRequired="2">
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/2/DSet2Mission1.xml" TargetComp="dhs" AssignmentTag="D3f4ult" StartsComplete="true"/>
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/2/DSet2Mission2.xml" TargetComp="dhs" AssignmentTag="Coel" StartsComplete="false"/>
    <AddMissionToHubServer MissionFilepath="DLC/Missions/Set/2/DSet2Mission3.xml" TargetComp="dhs"/>
    
    
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="9.0">Ладно, я пока что гляну на этот взломщик SSL, расшифрую его и упакую в более удобном виде.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="17.0">Похоже что большую часть работы здесь уже сделали до меня - мне знаком этот стиль трояна...</AddIRCMessage>
    <AddAsset FileName="SSLTrojan.exe" FileContents="#SSL_EXE#" TargetComp="dhsDrop" TargetFolderpath="bin" />
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="22.0">Хоть версия и недотестирована, использовать ее уже можно если есть желание. Я загрузил ее на дроп-сервер (/bin).</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="27.0">!ATTACHMENT:link#%#ДропСервер Bibliotheque#%#69.58.186.118</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="32.0">!ATTACHMENT:account#%#ДропСервер Bibliotheque#%#69.58.186.118#%#admin#%#ka2gs69</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="36.0">Эта программа использует уже открытый порт, чтобы взломать порт, использующий SSL.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="40.0">Поэтому тебе придется указать не только номер порта, использующего SSL, но еще и выбрать порт, через который ты хочешь подключиться.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="43.0">На данный момент используются следующие флаги: -s, -w и -f для ssh, http и ftp соответственно.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="45.0">Используется это следующим образом:</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="50.0">SSLTrojan [ПОРТ SSL] [ФЛАГ] [ПОРТ ДЛЯ ТУННЕЛЯ]</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="52.0">Краткое руководство:</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="62.0">!ATTACHMENT:note#%#Применение SSL-трояна#%#SSLTrojan [1] [2] [3]
1 = № SSL порта
2 =
"-s" для SSH-туннеля
"-f" для FTP-туннеля
"-w" для HTTP-туннеля
3 = № порта другого сервиса, через который подключиться.
Например: SSLTrojan 443 -w 80</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="66.0">Помни - SSLTrojan работает *ЧЕРЕЗ* другой порт, так что его сначала нужно открыть.</AddIRCMessage>
    <AddIRCMessage Author="D3f4ult" TargetComp="dhs" Delay="70.0">@channel - Новые игрушки! Читай выше.</AddIRCMessage>
    <AddIRCMessage Author="Kaguya" TargetComp="dhs" Delay="90.0">Отличный ликбез, @D3f4ult, спасибо.</AddIRCMessage>
  </Action>

